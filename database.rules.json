{
  "rules": {
    "estado": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'PEGAR_UID_DE_LA_PRESENTADORA'"
    },
    "latido": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'PEGAR_UID_DE_LA_PRESENTADORA'"
    },
    "conectados": {
      ".read": true,
      "$cid": {
        ".write": "$cid.length < 30",
        ".validate": "newData.isBoolean()"
      }
    },
    "respuestas": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'PEGAR_UID_DE_LA_PRESENTADORA'",
      "$q": {
        "$cid": {
          ".write": "$cid.length < 30",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        }
      }
    }
  }
}
